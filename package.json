{
  "name": "@sofra/customer-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "packageManager": "npm@11.11.0",
  "engines": {
    "node": ">=22.14.0 <23",
    "npm": "11.11.0"
  },
  "scripts": {
    "start": "expo start --dev-client",
    "android": "npm run native:generate -- --platform android && expo run:android",
    "ios": "npm run native:generate -- --platform ios && expo run:ios",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest --runInBand",
    "test:coverage": "jest --runInBand --coverage",
    "check:source": "node scripts/check-source.mjs",
    "check:duplicates": "jscpd src --ignore \"**/generated.ts,**/*.test.*\" --threshold 0 --min-lines 8 --min-tokens 65",
    "check": "npm run dependencies:verify && npm run format:check && npm run lint && npm run typecheck && npm run check:source && npm run test:tooling && npm run test:coverage && npm run check:duplicates",
    "hooks:install": "node scripts/install-hooks.mjs",
    "contracts:generate": "openapi-typescript contracts/customer.openapi.json -o src/api/generated.ts",
    "build": "node scripts/check-export-root.mjs && expo export --platform ios --platform android --output-dir dist && node scripts/check-bundle.mjs",
    "check:workflow": "node --test scripts/*.test.mjs",
    "dependencies:prepare": "node scripts/prepare-dependencies.mjs",
    "dependencies:verify": "node scripts/prepare-dependencies.mjs --verify",
    "test:security": "node --test security/*.test.mjs",
    "audit:security": "node scripts/audit-dependencies.mjs",
    "test:tooling": "c8 --all --check-coverage --lines 85 --statements 85 --functions 85 --branches 80 --include \"scripts/**/*.mjs\" --include \"security/**/*.{mjs,cjs}\" --exclude \"**/*.test.mjs\" --exclude \"security/fixtures/**\" --reporter lcov --reporter text --reports-dir coverage/tooling node scripts/check-tooling.mjs",
    "native:prepare": "node scripts/native-template.mjs",
    "native:generate": "npm run native:prepare && expo prebuild --no-install --template .local/native-template.tgz"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@tanstack/react-query": "5.104.4",
    "expo": "56.0.23",
    "expo-application": "56.0.3",
    "expo-camera": "56.0.8",
    "expo-crypto": "56.0.5",
    "expo-dev-client": "56.0.27",
    "expo-image": "56.0.13",
    "expo-linking": "56.0.18",
    "expo-localization": "56.0.6",
    "expo-router": "56.2.21",
    "expo-secure-store": "56.0.4",
    "expo-system-ui": "56.0.5",
    "expo-web-browser": "56.0.6",
    "i18next": "26.5.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-i18next": "17.1.0",
    "react-native": "0.85.3",
    "react-native-reanimated": "4.3.2",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "4.26.2",
    "react-native-worklets": "0.8.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@testing-library/react-native": "13.3.3",
    "@types/jest": "29.5.14",
    "@types/react": "19.2.2",
    "c8": "12.0.0",
    "eslint": "9.39.5",
    "eslint-config-expo": "56.0.4",
    "jest": "29.7.0",
    "jest-expo": "56.0.5",
    "jscpd": "5.4.1",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.10",
    "react-test-renderer": "19.2.3",
    "typescript": "5.9.3"
  },
  "overrides": {
    "sprintf-js": "1.1.3"
  }
}
